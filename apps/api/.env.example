# Copy this file to .env and fill in your values.
# The backend reads these on startup via os.environ.

# ---------------------------------------------------------------------------
# FHIR server (required)
# ---------------------------------------------------------------------------

# Default FHIR server base URL used when no X-FHIR-Base-URL header is sent.
# Change this to point to your target server for local development or testing.
#
# Common values:
#   eHealth test server (Belgium):   https://hapi.fhir-testserver.be/fhir/<tenantId>
#   Tiro FHIR server:                https://<tiro-host>/fhir/r4
#   Google Cloud Healthcare API:     https://healthcare.googleapis.com/v1/projects/<project>/locations/<location>/datasets/<dataset>/fhirStores/<store>/fhir
#   HAPI FHIR (public, no auth):     https://hapi.fhir.org/baseR4
FHIR_BASE_URL=https://hapi.fhir-testserver.be/fhir/tenantID

# Optional: API key sent as ?api_key=... query parameter on every FHIR request.
# Not used when GOOGLE_SERVICE_ACCOUNT_FILE is set.
FHIR_API_KEY=

# ---------------------------------------------------------------------------
# Google Cloud Healthcare API authentication (optional)
# ---------------------------------------------------------------------------

# Absolute path to a Google service account JSON key file.
# When set and the FHIR_BASE_URL starts with https://healthcare.googleapis.com,
# requests are authenticated using this service account. FHIR_API_KEY is ignored.
GOOGLE_SERVICE_ACCOUNT_FILE=

# ---------------------------------------------------------------------------
# SNOMED CT / Snowstorm (optional — only needed for concept search)
# ---------------------------------------------------------------------------

# FHIR $expand endpoint of your Snowstorm instance (used by /search_snomed_concept).
# Example: https://snowstorm.example.com/fhir/ValueSet/$expand
SNOMED_URL=

# Optional: path to a TLS client certificate (.pem) for Snowstorm, if required.
SNOMED_CERT_PATH=

# ---------------------------------------------------------------------------
# Mapping status CodeSystem (optional — advanced)
# ---------------------------------------------------------------------------

# CodeSystem URL used to tag Questionnaires with their mapping status (DONE / PARTIAL / NOT-STARTED).
# Override this if your FHIR server enforces a specific CodeSystem URL for meta.tag.
MAPPING_STATUS_SYSTEM=
