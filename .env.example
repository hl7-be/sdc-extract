# Copy this file to .env. Docker Compose reads it automatically; the curl
# scripts under scripts/curls/ read it too.

# ───────────────────────────────────────────────────────────────────────────
# Docker Compose — host ports
# ───────────────────────────────────────────────────────────────────────────
# The container ports are fixed; these only change what the host exposes.
# Defaults are chosen so the three services never collide.
HAPI_PORT=8080      # HAPI FHIR server      → http://localhost:8080/fhir
TIRO_PORT=8000      # Tiro SDC $extract API → http://localhost:8000/api/v1
MAPPER_PORT=4200    # Q2Rmapper UI          → http://localhost:4200

# ───────────────────────────────────────────────────────────────────────────
# Docker Compose — mapper FHIR target
# ───────────────────────────────────────────────────────────────────────────
# Where the Q2Rmapper backend reads/writes Questionnaires.
# - Full stack (`--profile full`): leave as-is to use the bundled HAPI service.
# - Mapper only (`--profile mapper`): set this to a reachable FHIR server,
#   e.g. https://hapi.fhir.org/baseR4 — the `hapi` host only exists in the
#   compose network.
MAPPER_FHIR_BASE_URL=http://hapi:8080/fhir
MAPPER_FHIR_API_KEY=
MAPPER_SNOMED_URL=

# ───────────────────────────────────────────────────────────────────────────
# curl scripts (scripts/curls/)
# ───────────────────────────────────────────────────────────────────────────
# Default target for the curl scripts. Points at the local extract service
# (apps/tiro_sdc_server) on TIRO_PORT. No credentials are required for it.
TIRO_BASE_URL=http://localhost:8000/api/v1

# Credentials for the eHealth testserver (HAPI). Only needed if you target
# eHealth (Test 1 supports it as an alternative server) or use the
# *_ehtestserver.sh helper scripts. Provided at the hackathon.
TENANT_ID=your-tenant-id
API_KEY=your-secret-api-key
