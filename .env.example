# Default target for the curl scripts under scripts/curls/. Points at the local
# Tiro testserver (apps/tiro_sdc_extract). Override only if you've deployed the
# server elsewhere — no credentials are required for the local instance.
TIRO_BASE_URL=http://localhost:8000/api/v1

# Credentials for the eHealth testserver (HAPI). Only needed if you target
# eHealth (Test 1 supports it as an alternative server) or use the
# *_ehtestserver.sh helper scripts. Provided at the hackathon.
TENANT_ID=your-tenant-id
API_KEY=your-secret-api-key
